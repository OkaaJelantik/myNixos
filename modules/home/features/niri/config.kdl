input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        tap-button-map "left-right-middle"
        dwt
        natural-scroll
        click-method "clickfinger"
        scroll-factor 0.7
        accel-speed 0.2
        accel-profile "adaptive"
    }

    mouse {
        accel-profile "flat"
    }
}

switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

// Outputs
output "eDP-1" {
    scale 1.0
}

// Layout
layout {
    gaps 15
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#b4befe"
        inactive-color "#313244"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000066"
    }
}

// Startup
spawn-at-startup "noctalia"

// Preferences
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"

// Animations
animations {
    slowdown 0.8
}


// ===== WINDOW RULES ===== //
// Global
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
// Inactive
window-rule {
	match is-active=false
	opacity 0.85
}

// ===== LAYER RULES === //
layer-rule {
  match namespace="noctalia-bar-default"
  background-effect {
    xray false
    blur false
  }
}



// Key Binds
binds {
    "Mod+Shift+E" { quit; }
    "Mod+Shift+R" { spawn "niri" "msg" "action" "reload-config"; }
     
    // Noctalia IPC
    "Mod+P"	 { spawn "noctalia" "msg" "panel-toggle" "elijaharch/wl-screen-mirror:controls"; }
    "Mod+D"      { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    "Mod+S"      { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    "Mod+Comma"  { spawn "noctalia" "msg" "settings-toggle"; }
    "Alt+Tab"    { spawn "noctalia" "msg" "window-switcher"; }
    
    // Apps
    "Mod+T"      { spawn "kitty"; }
    "Mod+W"      { spawn "firefox"; }
    "Mod+E"      { spawn "nautilus"; }

    // Window
    "Mod+Q"       { close-window; }
    "Mod+F"       { maximize-column; }
    "Mod+Shift+F" { fullscreen-window; }
    "Mod+C"       { center-column; }

    "Mod+H"     { focus-column-left; }
    "Mod+L"     { focus-column-right; }
    "Mod+J"     { focus-window-or-workspace-down; }
    "Mod+K"     { focus-window-or-workspace-up; }
    "Mod+Left"  { focus-column-left; }
    "Mod+Right" { focus-column-right; }
    "Mod+Down"  { focus-window-or-workspace-down; }
    "Mod+Up"    { focus-window-or-workspace-up; }

    "Mod+Shift+H"     { move-column-left; }
    "Mod+Shift+L"     { move-column-right; }
    "Mod+Shift+J"     { move-window-down-or-to-workspace-down; }
    "Mod+Shift+K"     { move-window-up-or-to-workspace-up; }
    "Mod+Shift+Left"  { move-column-left; }
    "Mod+Shift+Right" { move-column-right; }
    "Mod+Shift+Down"  { move-window-down-or-to-workspace-down; }
    "Mod+Shift+Up"    { move-window-up-or-to-workspace-up; }

    "Mod+Minus"       { set-column-width "-10%"; }
    "Mod+Equal"       { set-column-width "+10%"; }
    "Mod+Shift+Minus" { set-window-height "-10%"; }
    "Mod+Shift+Equal" { set-window-height "+10%"; }

    "Mod+1" { focus-workspace 1; }
    "Mod+2" { focus-workspace 2; }
    "Mod+3" { focus-workspace 3; }
    "Mod+4" { focus-workspace 4; }
    "Mod+5" { focus-workspace 5; }
    "Mod+Shift+1" { move-window-to-workspace 1; }
    "Mod+Shift+2" { move-window-to-workspace 2; }
    "Mod+Shift+3" { move-window-to-workspace 3; }
    "Mod+Shift+4" { move-window-to-workspace 4; }
    "Mod+Shift+5" { move-window-to-workspace 5; }
     
    "XF86AudioRaiseVolume"  { spawn-sh "noctalia msg volume-up"; }
    "XF86AudioLowerVolume"  { spawn-sh "noctalia msg volume-down"; }
    "XF86AudioMute"         { spawn-sh "noctalia msg volume-mute"; }
    "XF86MonBrightnessUp"   { spawn-sh "noctalia msg brightness-up"; }
    "XF86MonBrightnessDown" { spawn-sh "noctalia msg brightness-down"; }

    "Print"            { screenshot; }
    "Ctrl+Print"       { screenshot-screen; }
    "Alt+Print"        { screenshot-window; }
}
